{
  "name": "@kongchenhui/dsh-prompt-tuner",
  "version": "0.1.1",
  "description": "Composer prompt tuner: rewrite and correct the draft with one configurable prompt and model.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "license": "MIT",
  "author": "kongchenhui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongchenhui/dsh-prompt-tuner.git"
  },
  "homepage": "https://github.com/kongchenhui/dsh-prompt-tuner#readme",
  "bugs": {
    "url": "https://github.com/kongchenhui/dsh-prompt-tuner/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "cordis",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client && npm run build:types",
    "build:host": "tsdown --config tsdown.config.host.ts",
    "build:client": "tsdown",
    "build:types": "tsc -p tsconfig.build.json",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "prepare": "npm run build",
    "gen:locale": "node --experimental-strip-types scripts/gen-locale.ts",
    "verify:locale": "node --experimental-strip-types scripts/gen-locale.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^31.0.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
