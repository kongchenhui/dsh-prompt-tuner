{
  "name": "@kongchenhui/dsh-prompt-tuner",
  "version": "0.1.0",
  "description": "Composer prompt tuner: rewrite and correct the draft with one configurable prompt and model.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "kongchenhui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongchenhui/dsh-prompt-tuner.git"
  },
  "homepage": "https://github.com/kongchenhui/dsh-prompt-tuner#readme",
  "bugs": {
    "url": "https://github.com/kongchenhui/dsh-prompt-tuner/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "cordis",
    "react"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
